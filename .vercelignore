# Exclude backend and all Python-related files
backend/
api/
tests/
*.py
*.pyc

# Exclude ALL virtual environments everywhere
**/venv*/
**/venv311*/
**/env*/
**/bin/
**/include/
**/lib/
**/share/

# Exclude ALL cache
**/__pycache__/
**/.pytest_cache/
**/.cache/

# Exclude IDE and Git
.vscode/
.git/

# Only include nuevo-frontend for Vercel build
!nuevo-frontend/
.idea/
.git/

# Exclude Local Env
.env*
**/.env*

# Exclude documentation and samples
backend/cv_samples/
tests/
scripts/
*.md
!README.md

# Exclude large binary/temp files
# Exclude large binary/temp files
*.pdf
# Exclude specific large json files but allow config files
cv_output.json
*.zip
*.tar.gz
