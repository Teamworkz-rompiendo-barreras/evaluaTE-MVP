# backend/ and api/ ARE needed now (Python serverless functions) - do not exclude them.
tests/

# Exclude ALL virtual environments everywhere
**/venv*/
**/venv311*/
**/env*/
**/bin/
**/include/
**/lib/
**/share/

# Exclude ALL cache
**/__pycache__/
**/.pytest_cache/
**/.cache/

# Exclude IDE and Git
.vscode/
.git/
.idea/

# Exclude Local Env
.env*
**/.env*

# Exclude documentation and samples
backend/cv_samples/
scripts/
*.md
!README.md

# Exclude large binary/temp files
*.pdf
cv_output.json
*.zip
*.tar.gz
