{
  "buildCommand": "cd nuevo-frontend && npm install && npm run build",
  "outputDirectory": "nuevo-frontend/dist",
  "github": {
    "enabled": true,
    "autoAlias": true,
    "autoJobCancelation": true
  },
  "installCommand": "cd nuevo-frontend && npm install",
  "framework": "vite",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ]
}

